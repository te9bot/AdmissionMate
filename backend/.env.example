APP_NAME=AdmissionMate
DEBUG=true

DATABASE_URL=postgresql+asyncpg://admissionmate:admissionmate@localhost:5433/admissionmate
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_LENGTH=6
OTP_TTL_SECONDS=600

EXAM_CACHE_TTL_SECONDS=300

# console = logs OTP/notification emails to the backend console (no external provider needed)
# smtp    = sends real email via the SMTP_* settings below
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@admissionmate.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

NOTIFICATION_JOB_HOUR=8
NOTIFICATION_JOB_MINUTE=0
